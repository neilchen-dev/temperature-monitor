# 复制为 .env 后填写；此文件可以安全提交，.env 不会被 Git 跟踪。
# Docker 镜像仓库路径。请改成你自己的公开或私有镜像仓库，不要提交真实私有地址。
IMAGE_REPOSITORY=your-registry.example.com/your-namespace/temperature-monitor
# Docker Compose 默认拉取的版本；升级或回滚时只修改此值。
IMAGE_TAG=latest

APP_ID=
APP_SECRET=
APP_TOKEN=
TABLE_ID=

# Shadow Runtime：默认关闭；真实试运行前显式改为 shadow。
AUTOMATION_MODE=disabled
SHADOW_DEVICE_IDS=
# 自定义设备上下文时填写 JSON，例如
# {"TH-03":{"area":"精密装配间","control_type":"OPERATION_PERIOD"}}
SHADOW_DEVICE_CONTEXTS=
FEISHU_STANDARD_TABLE_ID=your_standard_table_id
FEISHU_OPERATION_TABLE_ID=your_operation_table_id
FEISHU_EVENT_TABLE_ID=your_event_table_id
# FEISHU_DEVICE_TABLE_ID 留空时复用 TABLE_ID。
FEISHU_DEVICE_TABLE_ID=
# 设备观察表中当前作业类型字段；默认与确认的“当前工艺”字段一致。
FEISHU_OBSERVATION_OPERATION_TYPE_FIELD=当前工艺
SHADOW_WORKER_ID=
SHADOW_SCHEDULER_POLL_SECONDS=1
SHADOW_OPERATION_SYNC_SECONDS=30
SHADOW_STANDARD_SYNC_SECONDS=300
SHADOW_FEISHU_DELAY_SECONDS=60
RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=15

# 历史采样接口共享密钥。请使用至少 32 字节随机值，并与 HA secrets.yaml 保持一致。
HISTORY_API_KEY=

# 可选：温度上报接口共享密钥。设置后 POST /temperature 需携带
# X-Temperature-Key 请求头；留空保持无鉴权（兼容旧 HA 配置）。
TEMPERATURE_API_KEY=

# 可选：参与历史采样的设备列表（逗号分隔）。留空使用默认 TH-01～TH-11；
# 覆盖时 HISTORY_TABLE_MAP 必须提供完全一致的设备映射。
HISTORY_DEVICES=
HISTORY_INTERVAL_MINUTES=10
HISTORY_TIMEZONE=Asia/Shanghai
HISTORY_CLEANUP_ENABLED=false
HISTORY_RETENTION_DAYS=90
HISTORY_CLEANUP_HOUR=2
# 只填写你自己飞书空间中的表 ID；真实 table_id 不要提交到 Git。
HISTORY_TABLE_MAP=

# 可选：设备名与飞书多维表格 record_id 的 JSON 映射。留空时自动按下方字段查找。
DEVICE_RECORD_MAP=
DEVICE_ID_FIELD=设备编号
# 可选：将 Home Assistant 实际上报的设备名映射到飞书表中的设备编号。
# 例如：{"sensor.warehouse_temp":"DEV-01"}
DEVICE_NAME_MAP=

# 如果 Home Assistant 发送摄氏温度，设为 C；发送华氏温度则设为 F。
SOURCE_TEMPERATURE_UNIT=C
PORT=5000
WAITRESS_THREADS=4

# SQLite 本地镜像：镜像温度上报与历史快照，便于本地查询与备份。
# 仅是飞书数据的副本，关闭或写入失败都不影响飞书主链路。
SQLITE_ENABLED=true
# SQLITE_DB_PATH=/app/data/temperature_monitor.db

# ---- 工业数据采集（可选，默认关闭）----
# Modbus 采集，支持 TCP 与 RTU 两种传输（输出到同一套统一设备模型/事件/API）。
# 无 PLC 硬件时可用 tools/modbus_simulator.py 起本地模拟器：
#   python tools/modbus_simulator.py --port 5020
# 再设置 MODBUS_ENABLED=true 后重启服务即可在 /api/devices 看到 PLC-01。
# 注意：多 worker 部署时只允许一个 worker 开启，避免重复轮询。
MODBUS_ENABLED=false
# 传输层：tcp（默认）| rtu（USB-RS485 / 串口变送器）
MODBUS_TRANSPORT=tcp
# --- TCP 专用 ---
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020
# --- RTU 专用（Windows 填 COM3，Linux 填 /dev/ttyUSB0）---
# 断线自动重连仅在串口路径不变时有效；COM 号/ttyUSB 编号变化需改配置重启。
MODBUS_SERIAL_PORT=
MODBUS_BAUDRATE=9600
MODBUS_PARITY=N
MODBUS_STOPBITS=1
MODBUS_BYTESIZE=8
MODBUS_UNIT_ID=1
MODBUS_DEVICE_ID=PLC-01
MODBUS_POLL_INTERVAL_SECONDS=5
MODBUS_TIMEOUT_SECONDS=5
# 可选 JSON 覆盖默认寄存器映射（每个测量字段占 1 个寄存器；type 可为
# holding=保持寄存器FC03（默认）或 input=输入寄存器FC04；device_status 可省略，
# 省略时读取成功即视为在线）。
# 注意：address 是零基 PDU 地址——手册中的 40001（第 1 个保持寄存器）填 0，
# 30001（第 1 个输入寄存器）也填 0；直接填 40001 会触发 Illegal Data Address。
# 稀疏地址会自动分段读取，不会展开成 min..max 的连续大区间：
# {"temperature":{"address":0,"scale":0.1,"encoding":"int16","type":"holding"},
#  "humidity":{"address":1,"scale":0.1,"encoding":"uint16"},
#  "device_status":{"address":2,"online_value":1}}
MODBUS_REGISTER_MAP=

# 设备事件：温度高于该摄氏度值时记录 NORMAL -> TEMPERATURE_HIGH 事件，回落后记录恢复。
# 留空关闭温度阈值事件；在线/离线状态变化事件始终记录（仅状态变化时）。
EVENT_TEMPERATURE_HIGH_C=
