# 复制为 .env 后填写；此文件可以安全提交，.env 不会被 Git 跟踪。
# Docker Compose 默认拉取的版本；升级或回滚时只修改此值。
IMAGE_TAG=1.2.1

APP_ID=
APP_SECRET=
APP_TOKEN=
TABLE_ID=

# 历史采样接口共享密钥。请使用至少 32 字节随机值，并与 HA secrets.yaml 保持一致。
HISTORY_API_KEY=

# 可选：温度上报接口共享密钥。设置后 POST /temperature 需携带
# X-Temperature-Key 请求头；留空保持无鉴权（兼容旧 HA 配置）。
TEMPERATURE_API_KEY=

# 可选：参与历史采样的设备列表（逗号分隔）。留空使用默认 TH-01～TH-11；
# 覆盖时 HISTORY_TABLE_MAP 必须提供完全一致的设备映射。
HISTORY_DEVICES=
HISTORY_INTERVAL_MINUTES=10
HISTORY_TIMEZONE=Asia/Shanghai
HISTORY_CLEANUP_ENABLED=false
HISTORY_RETENTION_DAYS=90
HISTORY_CLEANUP_HOUR=2
HISTORY_TABLE_MAP={"TH-01":"tbldiElwYsCb4gcE","TH-02":"tbljWQNUpGW9t3bm","TH-03":"tbla7CSkhXuskiER","TH-04":"tblttlcPgae1yTem","TH-05":"tblQcJG7xt0bRPlK","TH-06":"tblii2ZnHQ9kMN9P","TH-07":"tblaDZTIHvZUh2nf","TH-08":"tblY4lIhNbhcaOOS","TH-09":"tblE88Cb1hGL7Eno","TH-10":"tblA9G55kbjbA5wz","TH-11":"tblWCWdsNxh12dOc"}

# 可选：设备名与飞书多维表格 record_id 的 JSON 映射。留空时自动按下方字段查找。
DEVICE_RECORD_MAP=
DEVICE_ID_FIELD=设备编号
# 可选：将 Home Assistant 实际上报的设备名映射到飞书表中的设备编号。
# 例如：{"sensor.warehouse_temp":"DEV-01"}
DEVICE_NAME_MAP=

# 如果 Home Assistant 发送摄氏温度，设为 C；发送华氏温度则设为 F。
SOURCE_TEMPERATURE_UNIT=C
PORT=5000
WAITRESS_THREADS=4

# SQLite 本地镜像：镜像温度上报与历史快照，便于本地查询与备份。
# 仅是飞书数据的副本，关闭或写入失败都不影响飞书主链路。
SQLITE_ENABLED=true
# SQLITE_DB_PATH=/app/data/temperature_monitor.db
